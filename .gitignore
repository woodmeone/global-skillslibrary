# 依赖与缓存，不进库
node_modules/
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ---- 嵌套 git 仓库：各有远端，本库不收录 ----
# 它们的真实来源见 SKILLS.md 的「外部仓库」一节。
# 写成 /X/ 是只匹配根级目录，不会误伤子目录里的同名目录。
/MidNight/
/git-native-sop/
/mattpocock-skills/
/_backup/

# lead-learn 曾是嵌套仓库，2026-11-24 起并入本库直接收录（它没有独立远端）。
# 它原来的 .git 已移出到 _gitmeta/，回滚能力改由本库提供（见 lead-learn/docs/自优化流程.md）。
/lead-learn/__pycache__/
/lead-learn/scripts/__pycache__/
/lead-learn/.pytest_cache/

# 归档的旧仓库元数据，不进版本控制
/_gitmeta/

# ---- 大文件：模型权重不进库 ----
# bge-m3 是 2161 MB，超 GitHub 单文件 100 MB 硬限制。
# 新环境用 recall 自带的 scripts/download_bge_m3.py 拉取。
models/
*.onnx_data
*.onnx
*.safetensors
*.bin
*.gguf

# ---- 凭据：一律不进库 ----
*cookies*.txt
*cookies*.json
cookiecloud.json
.env
.env.*
*.pem
id_rsa*

# ---- 运行产物 ----
*.log
media-downloads/
.favorites-out/
scratch/
.scratch/

# ---- 编辑器 ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
