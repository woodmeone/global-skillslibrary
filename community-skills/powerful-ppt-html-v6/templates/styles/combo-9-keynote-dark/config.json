    "--color-primary": "#60a5fa",
    "--color-secondary": "#a78bfa",
    "--color-accent": "#f093fb",
    "--color-success": "#34d399",
    "--color-warning": "#fbbf24",
    "--color-danger": "#f87171",
    "--chart-color-1": "#60a5fa",
    "--chart-color-2": "#a78bfa",
    "--chart-color-3": "#f093fb",
    "--chart-color-4": "#34d399",
    "--chart-color-5": "#fbbf24",
    "--chart-color-6": "#f87171",
    "--chart-text": "#ffffff",
    "--chart-text-secondary": "#9ca3af",
    "--chart-grid": "rgba(156,163,175,0.15)",
