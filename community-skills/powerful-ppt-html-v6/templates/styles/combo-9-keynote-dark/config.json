{
  "id": "combo-9",
  "name": "Keynote Dark",
  "name_cn": "乔布斯深色科技",
  "version": "5.0.0",
  "best_for": ["Product launch", "Data reports", "Tech talks"],
  "theme": "dark",
  "pptx_bg": "000000",
